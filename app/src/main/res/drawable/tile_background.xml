<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#182820" />
            <corners android:radius="18dp" />
            <stroke android:width="3dp" android:color="#1AAE66" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#20372A" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="#168D53" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#171D25" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#2A3440" />
        </shape>
    </item>
</selector>
