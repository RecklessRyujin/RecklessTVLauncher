<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10151C">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp"
        android:scrollbars="none"
        android:focusable="false"
        android:descendantFocusability="afterDescendants">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="22dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RECKLESS"
                        android:textColor="#1AAE66"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.18" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Your TV. Your way."
                        android:textColor="#F3F6F9"
                        android:textSize="27sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="YOUR APPS, READY WHEN YOU ARE"
                        android:textColor="#84909E"
                        android:textSize="10sp"
                        android:letterSpacing="0.12" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="20dp">
                    <TextView
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--:--"
                        android:textColor="#F3F6F9"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Loading date"
                        android:textColor="#84909E"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="YOUR APPS"
                    android:textColor="#DCE4EB"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />
                <TextView
                    android:id="@+id/app_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 APPS"
                    android:textColor="#84909E"
                    android:textSize="10sp"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/app_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="4"
                android:useDefaultMargins="false"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingBottom="12dp"
                android:text="QUICK ACCESS"
                android:textColor="#DCE4EB"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <HorizontalScrollView
                android:id="@+id/quick_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="false"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="false"
                android:descendantFocusability="afterDescendants">
                <LinearLayout
                    android:id="@+id/quick_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:text="RECKLESS TV  •  LIGHTWEIGHT HOME"
                android:textColor="#5D6977"
                android:textSize="10sp"
                android:letterSpacing="0.08" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
